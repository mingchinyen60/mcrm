# =================================================================
# Synology NAS Custom CRM Environment Configuration
# Target Hardware: Synology NAS (192.168.1.224)
# =================================================================

# Database Configuration
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_secure_vault_2026

# Synology NAS Storage Mount
# On Synology DSM Container Manager, map this to your shared folder (e.g. /volume1/docker/crm/postgres_data)
DATA_PATH=/volume1/docker/crm/postgres_data

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
